{
  "name": "unroute",
  "version": "3.0.0",
  "description": "Unroute — PAC-расширение Manifest V3 для Chromium и Firefox",
  "scripts": {
    "icons:generate": "node scripts/generate-icons.mjs",
    "store:package": "npm run build:all && node scripts/package-stores.mjs",
    "store:screenshots": "node scripts/store-screenshots.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "version": "npm run version:sync",
    "bump:patch": "npm version patch --no-git-tag-version",
    "prebuild": "npm run version:check",
    "prebuild:chrome": "npm run version:check",
    "prebuild:firefox": "npm run version:check",
    "prebuild:all": "npm run version:check",
    "prelint": "npm run version:check",
    "pretest": "npm run version:check",
    "build": "gulp buildChrome",
    "build:chrome": "gulp buildChrome",
    "build:firefox": "gulp buildFirefox",
    "build:all": "gulp buildTargets",
    "lint": "eslint --config .eslintrc.cjs \"src/**/*.js\" \"test/**/*.js\" \"scripts/*.mjs\" \".github/scripts/*.mjs\" gulpfile.cjs --ignore-pattern vendor",
    "prelint:firefox": "npm run build:firefox",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "audit:ci": "node scripts/audit-dependencies.mjs",
    "test": "mocha --recursive test/**/*.test.js",
    "test:browser:chrome": "node test/browser/chrome-smoke.js",
    "test:browser:firefox": "node test/browser/firefox-tabs-smoke.js && node test/browser/native-popup-smoke.js",
    "test:browser:popup": "node test/browser/native-popup-smoke.js",
    "test:ui:fidelity": "node test/browser/popup-fidelity.mjs && node test/browser/options-fidelity-01.mjs && node test/browser/sites-status-layout.mjs --built",
    "prestart:firefox": "npm run build:firefox",
    "start:firefox": "web-ext run --source-dir dist/firefox",
    "prepackage:firefox": "npm run build:firefox",
    "package:firefox": "web-ext build --source-dir dist/firefox --artifacts-dir artifacts/firefox --overwrite-dest",
    "presign:firefox": "npm run build:firefox",
    "sign:firefox": "web-ext sign --source-dir dist/firefox --artifacts-dir artifacts/firefox-signed --channel unlisted --approval-timeout 900000 --no-input"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.0.0"
  },
  "license": "GPL-3.0-or-later",
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "devDependencies": {
    "@puppeteer/browsers": "3.2.6",
    "acorn": "^8.18.0",
    "chai": "^4.5.0",
    "del": "^6.1.1",
    "eslint": "^8.57.1",
    "gulp": "^5.0.1",
    "jszip": "3.10.1",
    "mocha": "^10.8.2",
    "puppeteer-core": "25.16.0",
    "tldts": "^7.4.11",
    "web-ext": "10.8.0"
  },
  "type": "module"
}
