{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "ru",
  "description": "__MSG_extDesc__",
  "version": "3.0.1",
  "icons": {
    "16": "icons/default-16.png",
    "32": "icons/default-32.png",
    "48": "icons/default-48.png",
    "128": "icons/default-128.png"
  },
  "permissions": [
    "proxy",
    "alarms",
    "storage",
    "unlimitedStorage",
    "tabs",
    "contextMenus",
    "notifications",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "service-worker.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "/pages/popup/index.html",
    "default_icon": {
      "16": "icons/default-16.png",
      "32": "icons/default-32.png",
      "48": "icons/default-48.png",
      "128": "icons/default-128.png"
    }
  },
  "options_ui": {
    "page": "/pages/firefox-private-browsing/index.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "unroute@xsodx-stack.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "authenticationInfo"
        ]
      }
    }
  }
}
